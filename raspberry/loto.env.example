# Clé de diffusion du service OpenLoto.
# Copiez ce fichier en /opt/loto/loto.env et remplacez la valeur ci-dessous
# par une clé aléatoire (à changer à chaque loto si vous le souhaitez).
#   Générer une clé :  openssl rand -hex 24
#   Après modification :  sudo systemctl restart loto
LOTO_KEY=remplacez-moi
